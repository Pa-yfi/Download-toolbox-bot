# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it is in .gitignore).

# Telegram bot token from @BotFather
BOT_TOKEN=
# Optional: Instagram login for stories & private-ish features.
# Leave empty to disable story lookup (public posts/reels still work).
IG_USERNAME=
IG_PASSWORD=
# Or use a saved instaloader session file instead of a password:
IG_SESSION_FILE=

# RECOMMENDED for Instagram: reuse your browser's logged-in Instagram cookies.
# Option A - read cookies straight from a browser you're logged into IG with:
#   firefox / edge / brave  (Chrome on Windows often fails: cookie encryption)
COOKIES_FROM_BROWSER=
# Option B - a Netscape-format cookies.txt exported with a browser extension
# like "Get cookies.txt LOCALLY" while on instagram.com:
IG_COOKIES_FILE=

# Max upload size in MB (Telegram bot API limit is 50 MB for bots)
MAX_FILE_MB=49

# Where temp downloads go
DOWNLOAD_DIR=./downloads

# Optional for inline mode: a private channel/group id (bot must be admin)
# where files are uploaded to get file_ids. Empty = use the user's PM.
INLINE_DUMP_CHAT=

# Your own Telegram user id (get it from @userinfobot). Unlocks /stats,
# /health, /ban, /unban, /broadcast and exempts you from the daily limit.
ADMIN_ID=

# Downloads allowed per user per day
DAILY_LIMIT=40

# Hard timeout for any single download, in seconds
DOWNLOAD_TIMEOUT=600

# Self-hosted Bot API server (lifts 50MB upload cap to 2GB). See README.
# e.g. LOCAL_API_URL=http://127.0.0.1:8081
LOCAL_API_URL=
